{
  "manifest_version": 3,
  "name": "CatWorld Auto Command",
  "version": "1.47.0",
  "description": "Configurable commands with immediate stop on verification prompts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://catworld.muds.tw/*",
    "https://api.line.me/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CatWorld Auto Command"
  },
  "content_scripts": [
    {
      "matches": [
        "https://catworld.muds.tw/web*"
      ],
      "js": [
        "trigger-engine.js",
        "timer-settings.js",
        "macro-wait.js",
        "macro-notes.js",
        "macro-io.js",
        "macro-io-ui.js",
        "captcha-art.js",
        "instance-guard.js",
        "zap-mobs.js",
        "zap-items.js",
        "zap-riddles.js",
        "zap-equipment.js",
        "zap-panel.js",
        "zap-riddle-ui.js",
        "zap-equipment-ui.js",
        "pip-panel.js",
        "stats-view.js",
        "stats-block.js",
        "content.js"
      ],
      "css": [
        "macro-notes.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
