{
  "manifest_version": 3,
  "name": "CatWorld Auto Command",
  "version": "1.115.4",
  "description": "Configurable commands with immediate stop on verification prompts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://catworld.muds.tw/*",
    "https://api.line.me/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CatWorld Auto Command"
  },
  "content_scripts": [
    {
      "matches": [
        "https://catworld.muds.tw/web*"
      ],
      "js": [
        "trigger-engine.js",
        "timer-settings.js",
        "macro-wait.js",
        "macro-notes.js",
        "macro-io.js",
        "macro-io-ui.js",
        "macro-resize.js",
        "captcha-art.js",
        "captcha-grid.js",
        "instance-guard.js",
        "stop-keywords.js",
        "chat-reply.js",
        "chat-script.js",
        "zap-mobs.js",
        "map-data.js",
        "map-collect.js",
        "map-route.js",
        "hunt-parse.js",
        "map-hunt.js",
        "map-hunt-ui.js",
        "zap-items.js",
        "zap-riddles.js",
        "zap-equipment.js",
        "shop-data.js",
        "shop-collect.js",
        "zap-panel.js",
        "zap-riddle-ui.js",
        "mentor-data.js",
        "mentor-search.js",
        "mentor-ui.js",
        "zap-equipment-ui.js",
        "pip-panel.js",
        "stats-view.js",
        "stats-block.js",
        "whisper-block.js",
        "skill-moves.js",
        "force-cap.js",
        "content.js"
      ],
      "css": [
        "macro-notes.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
